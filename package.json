{
  "name": "astra-chat",
  "productName": "AstraChat",
  "version": "0.1.0-alpha17",
  "description": "AstraChat —— 星辰跃动工作室出品的轻量级多模型 AI 聊天客户端",
  "author": "星辰跃动工作室 (XingChenYueDong Studio)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder && node scripts/publish-releases.mjs",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
